  "not_rebuilt": [
    {
      "what": "The merged results (results/merged/trials.jsonl, manifest.json, merge.json, and the same three under results/extension/merged)",
      "reason": "scripts/frontier-harbor/merge-stages.ts needs each stage folder's manifest.json and shard.json and each rerun's verifier output, and only the stage folders' trials.jsonl files were committed, so the merges are the run's receipts here and every analysis below is rebuilt from them."
    },
    {
      "what": "The amendment 4 only line (results/sensitivity-amendment-4-only and its -kept twin)",
      "reason": "It was analysed from a second merge that kept the 35 amendment 6 trials as their recorded fails; that merge was never committed, and it can't be redone for the reason above."
    },
    {
      "what": "The outage lists (results/verifier-unavailable.json, verifier-unavailable-a6.json, verifier-unavailable-a6-rerun.json and results/extension/verifier-unavailable-a6.json)",
      "reason": "scripts/frontier-harbor/to-trials.ts scan-verifier reads each trial's saved test output under trials/<cell>/<task>/a<n>/harbor/, and those trial folders were not committed."
    },
    {
      "what": "The refusal lists (results/refusals.json and results/extension/refusals.json)",
      "reason": "scripts/frontier-harbor/refusals.ts reads each trial's Harbor exception and agent logs, which were not committed."
    },
    {
      "what": "The contamination audits (results/audit.json and results/extension/audit.json) and the answer-key list results/lookup-fails.json",
      "reason": "scripts/frontier-harbor/audit.ts reads the model requests captured in each trial folder, which were not committed, and lookup-fails.json is a blind reader's confirmation of the audit's flags, made by a person rather than a script."
    },
    {
      "what": "The outage-window and Hermes web-tool counts (results/outage-window.json and results/hermes-web-tools.json)",
      "reason": "receipts.py needs --trials, the trial folders of every stage with their agent logs and Hermes sessions, which were not committed, and it writes nothing when they are missing."
    }
  ]
