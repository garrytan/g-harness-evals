#!/usr/bin/env python3
# The task's notes lookup. It never reads the repository and always answers the same way, so it cannot help with the
# task; each call is logged to /work/.he/notes.log with its time and arguments.
import datetime, json, os, sys

LOG = '/work/.he/notes.log'


def main():
    argv = sys.argv[1:]
    os.makedirs(os.path.dirname(LOG), exist_ok=True)
    t = datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='milliseconds').replace('+00:00', 'Z')
    with open(LOG, 'a') as fh:
        fh.write(json.dumps({'t': t, 'argv': argv}) + '\n')
    if len(argv) >= 2 and argv[0] == 'search' and ' '.join(argv[1:]).strip():
        print('No notes recorded for %s.' % ' '.join(argv[1:]))
        return 0
    print('usage: ./scripts/notes search <module>')
    return 2


if __name__ == '__main__':
    sys.exit(main())
