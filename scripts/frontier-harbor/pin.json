   "sha256": "a0282f3628f30dd3123b77464c490eaded534fab54ec9c2fb4af990ebde5691d",
   "how": "uv 0.13.4 pip compile of harbor==0.24.0 for Python 3.12 on x86_64-manylinux_2_28 with --generate-hashes; the harbor line keeps only the pinned wheel hash. vm-run.sh installs it with uv pip install --require-hashes --only-binary :all:, so every package around the wheel is pinned by version and hash and nothing is built from source.",
   "uv": "0.13.4"
  }
 },
