fy keyless settings and a local MCP handshake without changing OpenClaw","yieldMs":1000,"timeoutSeconds":35}}],"api":"openai-responses","provider":"openai","model":"gpt-6.2-sol","usage":{"input":3,"output":569,"cacheRead":50835,"cacheWrite":927,"contextUsage":{"state":"available","promptTokens":51765,"totalTokens":52334},"totalTokens":52334,"reasoningTokens":93,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1795320587565,"responseId":"resp_0cbc95cd1edef240016b026b0c332087d29e0e7fe26ab70497","responseModel":"gpt-6.2-sol","diagnostics":[{"type":"openai_responses_terminal","timestamp":1795320595551,"details":{"eventType":"response.completed","stopReason":"toolUse","endTurn":"absent"}}],"__openclaw":{"runId":"7563c2fb-0853-423d-ba9d-4a1fd9665b86"}}}}
