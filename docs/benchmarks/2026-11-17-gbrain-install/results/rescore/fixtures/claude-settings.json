{
 "hooks": {
  "SessionStart": [
   {
    "hooks": [
     {
      "type": "command",
      "command": "env /harness-state/.gbrain/hook-launcher/gbrain-hook /harness-state/.bun/bin/gbrain hook session-start",
      "timeout": 5,
      "_gbrain": "setup-v1"
     }
    ]
   }
  ],
  "UserPromptSubmit": [
   {
    "hooks": [
     {
      "type": "command",
      "command": "env /harness-state/.gbrain/hook-launcher/gbrain-hook /harness-state/.bun/bin/gbrain hook user-prompt",
      "timeout": 3,
      "_gbrain": "setup-v1"
     }
    ]
   }
  ]
 }
}
