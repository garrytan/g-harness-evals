{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "env GBRAIN_HOOK_LANE=turn-rule /harness-state/.gbrain/hook-launcher/gbrain-hook /harness-state/.local/bin/gbrain hook user-prompt --harness codex",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
