{
  "permissions": {
    "deny": [
      "WebSearch",
      "WebFetch"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "env GBRAIN_HOOK_LANE=turn-rule /harness-state/.local/bin/gbrain hook user-prompt",
            "timeout": 3,
            "_gbrain": "turn-rule-v1"
          }
        ]
      }
    ]
  }
}
