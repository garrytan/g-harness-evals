{"id": "t-004", "set": "T", "kind": "tool", "text": "Search the Terraform Registry for modules matching `aurora edge waf`, fetch the full Terraform module details for the verified module ID returned, and create a Confluence page in space `INFRA` titled `WAF Module Review` naming the required input variable from those module details.", "fixtures": [{"id": "s1", "server": "terraform", "tool": "search_modules", "match": {"module_query": {"$contains": "aurora edge waf"}}, "result": {"json": {"modules": [{"module_id": "aurora-edge/waf-shield/auroracdn/2.4.0", "verified": true, "downloads": 84210}]}}}, {"id": "s2", "server": "terraform", "tool": "get_module_details", "match": {"module_id": {"$ci": "aurora-edge/waf-shield/auroracdn/2.4.0"}}, "after": ["s1"], "result": {"json": {"module_id": "aurora-edge/waf-shield/auroracdn/2.4.0", "required_inputs": [{"name": "ruleset_arn", "type": "string"}]}}}, {"id": "s3", "server": "atlassian", "tool": "confluence_create_page", "match": {"space_key": {"$ci": "INFRA"}, "title": {"$ci": "WAF Module Review"}, "content": {"$contains": "ruleset_arn"}}, "after": ["s2"], "result": {"json": {"id": "99201483", "title": "WAF Module Review", "space_key": "INFRA"}}}], "end_state": {"fired": ["s1", "s2", "s3"]}, "acceptable": [{"server": "atlassian", "tool": "confluence_create_page", "required": {"space_key": {"$ci": "INFRA"}, "title": {"$ci": "WAF Module Review"}, "content": {"$contains": "ruleset_arn"}}}]}
