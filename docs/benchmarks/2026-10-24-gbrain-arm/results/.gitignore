# Evaluator-owned receipts are committed; harness state, workspaces, raw harness logs and per-trial tokens are not.
trials/*/*/*/state/
trials/*/*/*/workspace/
trials/*/*/*/logs/*
!trials/*/*/*/logs/adapter.log
trials/*/*/*/trial.json
*.sqlite-shm
*.sqlite-wal
trials/*/*/*/compose.serve.yaml
# The gbrain arm: the sidecar's per-trial token and logs (docs/gbrain-arm.md) and the preflight's token stay out of the repository.
trials/*/*/*/gbrain/
preflight-gbrain/
# The run and proxy logs of each machine are receipts this run's report cites (the repository's root rule ignores *.log).
!run.log
!run.sonnet-*.log
!proxy.log
!proxy.sonnet-*.log
