# Evaluator-owned receipts are committed, with each trial's adapter.log (the preregistration's Receipts section).
# Harness state, workspaces, the other harness logs and per-trial tokens are not.
trials/*/*/*/state/
trials/*/*/*/workspace/
trials/*/*/*/logs/*
!trials/*/*/*/logs/adapter.log
trials/*/*/*/trial.json
trials/*/*/*/compose.serve.yaml
*.sqlite-shm
*.sqlite-wal
# The repository's root rule ignores *.log; these are receipts this run's report cites.
!*.run.log
!*.proxy.log
!*.preflight.log
!*.plan.log
!*.run-shard.log
!adapter.log
