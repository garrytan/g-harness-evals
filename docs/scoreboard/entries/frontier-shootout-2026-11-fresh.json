    "path": "per_harness[*].with_stops[*][?set=fresh][?model!=sonnet]",
    "label": "preregistered per-harness readings, each model against Claude Opus 5.5 in the same harness, Holm-adjusted within each model",
    "a": "swe-{model}-{harnesses[0]}",
    "b": "swe-opus-{harnesses[0]}",
    "between": "models",
    "verdict_key": "label",
    "words": {
      "can't tell": "can't tell apart",
      "behind": "behind",
      "within 10 points, no measurable difference": "within 10 points"
    }
  },
  "paired_cost": {
    "trials": [
      "results/shards/s05/trials.jsonl",
