      "path": "cells[id={cell}].cost.per_solve.usd"
    },
    "usd_per_solved_ci95": {
      "file": "results/analysis/analysis.json",
      "path": "cells[id={cell}].cost.per_solve.ci95"
    },
    "usd_per_trial": {
      "file": "results/analysis/analysis.json",
      "path": "cells[id={cell}].cost.usd",
