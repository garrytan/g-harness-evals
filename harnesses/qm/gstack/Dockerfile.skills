# S1 probe fixture: the QM sandbox image with gstack's raw SKILL.md files staged
# at /root/workspace/gstack/<skill>/SKILL.md, the paths the paste-in router in
# the org SOUL names. Built by harnesses/qm/gstack/s1-stage.ts from a context
# directory holding gstack/ at one pinned gstack commit (each file read with
# git show <commit>:<path>). /root is the scope's home volume in QM's local
# backend; Docker copies the image's /root into a new empty volume, so every
# sandbox QM creates from this image starts with the files in its workspace.
ARG BASE=harness-eval/qm-sandbox:dev
FROM ${BASE}
ARG GSTACK_COMMIT
ARG GSTACK_VERSION
COPY gstack/ /root/workspace/gstack/
LABEL org.harness-eval.gstack.commit="${GSTACK_COMMIT}" org.harness-eval.gstack.version="${GSTACK_VERSION}" org.harness-eval.gstack.overlay="qm-s1-skills"
