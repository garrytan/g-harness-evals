# QM local sandbox image, built from the pinned QM source the way
# scripts/local-sandbox-build.sh in the QM repository does (fly/Dockerfile as
# the base, local/Dockerfile on top). Core spawns one of these per scope
# through the Docker socket; the agent's shell and file tools run inside it.
# Left off from fly/Dockerfile: the browser engine stage
# (INSTALL_BROWSER_ENGINE=0, QM's default), the AWS CLI, and the arm64 gh
# branch (this image is amd64 only).
#
# QM is pinned by commit (main has no release tag past v0.1.15): QM_COMMIT is
# fetched by sha and the build fails when HEAD is not that commit.
ARG QM_REPO=https://github.com/yc-software/qm
ARG QM_VERSION=main@90e4ced7
ARG QM_COMMIT=90e4ced75dba0f711e9737e5bb2f2d718870fb0f
FROM node:24-alpine@sha256:8a32c8cf649a49915a66e81e7a609223c708d0adabf288ee3f4077d765542f85 AS src
ARG QM_REPO QM_COMMIT
RUN apk add --no-cache git \
    && git init -q /src && cd /src \
    && git remote add origin "${QM_REPO}" \
    && git fetch --quiet --depth 1 origin "${QM_COMMIT}" && git checkout -q FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = "${QM_COMMIT}" \
    && echo "qm checkout $(git rev-parse HEAD)" \
    && rm -rf /src/.git

FROM node:24.22.1-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205 AS node-runtime
RUN npm install -g --allow-scripts=@anthropic-ai/claude-code \
      @anthropic-ai/claude-code@2.1.210 \
      @openai/codex@0.144.4

FROM debian:12-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818
ARG QM_VERSION QM_COMMIT
LABEL org.opencontainers.image.title="harness-eval QM local sandbox" \
      harness-eval.harness="qm" \
      harness-eval.version="${QM_VERSION}" \
      harness-eval.commit="${QM_COMMIT}" \
      harness-eval.role="sandbox"
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      bash coreutils findutils grep sed gawk \
      git curl wget jq unzip \
      nftables \
      python3 python3-venv python3-pip \
      ca-certificates gnupg \
  && rm -rf /var/lib/apt/lists/*
COPY --from=node-runtime /usr/local/ /usr/local/
ARG GH_VERSION=2.93.0
RUN curl -fsSL "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_amd64.tar.gz" -o /tmp/gh.tgz \
  && echo "02d1290eba130e0b896f3709ffff22e1c75a51475ddb70476a85abc6b5807af0  /tmp/gh.tgz" | sha256sum -c - \
  && tar xzf /tmp/gh.tgz -C /tmp \
  && install "/tmp/gh_${GH_VERSION}_linux_amd64/bin/gh" /usr/local/bin/gh \
  && rm -rf /tmp/gh* \
  && gh --version \
  && rm -rf /root/.local/state/gh
RUN claude --version && codex --version
RUN python3 -m venv /opt/agent-venv && /opt/agent-venv/bin/pip install --no-cache-dir --upgrade pip
ENV PATH="/opt/agent-venv/bin:${PATH}" VIRTUAL_ENV=/opt/agent-venv
COPY --from=src /src/fly/tools/x-api /usr/local/bin/x-api
RUN chmod +x /usr/local/bin/x-api
ENV ANONYMIZED_TELEMETRY=false BROWSER_USE_CLOUD_SYNC=false
# local/Dockerfile layer: the in-sandbox agent daemon core talks to.
COPY --from=src /src/cli/templates/aws/microvm-agent/agent.mjs /opt/microvm-agent/agent.mjs
ENV HOME=/root
WORKDIR /root
EXPOSE 8080
CMD ["node", "/opt/microvm-agent/agent.mjs"]
