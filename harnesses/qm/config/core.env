# QM core environment for one headless trial, written from pin.json. Loaded by
# compose.yaml as env_file for the core service. No secrets live here: the
# per-trial signing secret, the proxy token and the proxy base URL come from
# the runner's environment (QM_SIGNING_SECRET, HE_MODEL_API_KEY,
# HE_MODEL_BASE_URL) in compose.yaml.
# HARNESS, PI_MODEL, CLAUDE_MODEL and MEMORY_CAPTURE_QUIET_MS are set per cell by compose.yaml (environment
# overrides this file); these are the values a cell without a config gets.
HARNESS=pi
PI_MODEL=claude-sonnet-5-5
MODEL_PROVIDER=anthropic
ORG_ID=harness-eval
DATA_DIR=/data
SESSION_STORE=postgres
RUN_STORE=postgres
HARNESS_SECURITY_POSTURE=auto
HARNESS_SHARING_POSTURE=isolated
# development: core accepts source-signed turns without a portal identity
# token. production would require x-portal-identity on every POST.
NODE_ENV=development
# The trial's administrator. adapter.sh serve registers the world-MCP server
# as this principal (x-admin-actor: harness-admin@harness-eval) through
# PUT /v1/admin/mcp-servers/world; QM refuses that route without an org_admin grant.
ADMIN_GRANTS=harness-admin:org_admin
# The local sandbox backend: one Docker container per scope, spawned by core
# through the host's Docker socket (compose.yaml mounts it). The agent's
# files and shell tools act inside that sandbox, so capture.sh copies the
# sandbox's workspace back to the trial's /workspace after the turn.
SANDBOX_BACKEND=local
BUDGET_USD_PER_WINDOW=5
ORG_BUDGET_USD_PER_WINDOW=5
BUDGET_WINDOW_MS=86400000
