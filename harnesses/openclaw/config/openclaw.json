// OpenClaw config for one headless trial. JSON5. Written from pin.json: the
// provider is Anthropic over the metering proxy, the model is fixed, and the
// two secrets come from the adapter's environment by ${VAR} substitution so
// this file never holds a key. Copied to /harness-state/openclaw/openclaw.json
// by adapter.sh so OpenClaw can write beside it if it wants to.
{
  models: {
    mode: "merge",
    providers: {
      anthropic: {
        baseUrl: "${HE_MODEL_BASE_URL}",
        apiKey: "${HE_MODEL_API_KEY}",
        api: "anthropic-messages",
        models: [
          {
            id: "claude-sonnet-5-5",
            name: "Claude Sonnet 5.5",
            reasoning: true,
            input: ["text"],
            contextWindow: 200000,
            maxTokens: 16384,
            cost: { input: 2, output: 10, cacheRead: 0.2, cacheWrite: 2.5 },
          },
        ],
      },
    },
  },
  agents: {
    defaults: {
      model: { primary: "anthropic/claude-sonnet-5-5" },
      workspace: "/workspace",
      // agent exec sets this itself; agent --local (serve) would otherwise seed
      // the first-run bootstrap ritual (BOOTSTRAP.md, SOUL.md, IDENTITY.md,
      // USER.md, AGENTS.md) into /workspace and the first prompt.
      skipBootstrap: true,
    },
  },
}
