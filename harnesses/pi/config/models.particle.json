{
  "providers": {
    "particle": {
      "baseUrl": "${HE_MODEL_BASE_URL}/v1",
      "apiKey": "$HE_MODEL_API_KEY",
      "api": "openai-completions",
      "models": [
        {
          "id": "${HE_MODEL_NAME}",
          "name": "${HE_MODEL_NAME}",
          "reasoning": true,
          "input": [
            "text"
          ],
          "contextWindow": 1048576,
          "maxTokens": 128000,
          "compat": {
            "maxTokensField": "max_completion_tokens",
            "supportsUsageInStreaming": true,
            "supportsReasoningEffort": true
          }
        }
      ]
    }
  }
}
