node_modules/
node_modules
# Bun's transpiler cache, when a bun process runs with HOME at the checkout.
.bun/
results/
.budget/
# Harbor writes its job directories (task bodies, transcripts, logs) to jobs/ where it runs (internal-task).
/jobs/
*.log
.DS_Store

# Receipts of counted and pilot runs are committed under docs/benchmarks/<run>/results/ (that directory has its own .gitignore).
!docs/benchmarks/*/results/
# scripts/replicate.ts writes a rerun under replications/<run id>/ and bundles its prereg.json and results/ from there; the
# ledger, state, report, logs, the rerun bundle and downloaded archives stay out.
replications/*/*
!replications/*/prereg.json
!replications/*/results/
replications/.bundles/
# sqlite side files a reader opens beside a committed ledger (`<shard>.ledger.sqlite` as well as `ledger.sqlite`) are never receipts.
*.sqlite-shm
*.sqlite-wal
gbrain/.build/
# internal-task: a Claude Code or Codex installer view (gbrain-install/<harness>-installer/<split>/, also <shard>.gbrain-install/ after a merge)
# holds the compiled gbrain its hook runs, about 207 MB; the view's manifest.json records its sha256.
**/*gbrain-install/*-installer/*/home/.local/bin/gbrain
# Each Claude Code or Codex installer trial copies that binary into its state dir (<trial>/state/.local/bin/gbrain); run-shard.sh
# prunes it, and it is never committed with a run's receipts.
**/state/.local/bin/gbrain
# gstack-pregate and gstack-ship-receipt records written while shipping; the policy .gstack/pregate.json is committed.
.gstack/tmp/
.public-export-tools/
# A test run can leave a bun cache in the checkout; it is never committed, and it would stale gstack's evidence fingerprints.
/.bun/
# scripts/public-export/export.ts (and tests/public-export-cli.test.ts) download gitleaks, trufflehog and git-filter-repo here; an untracked tree here broke a /ship test lane on #238.
/.public-export-tools/
