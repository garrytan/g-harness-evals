            "type": "string"
          },
          "target_timezone": {
            "default": "UTC",
            "description": "Target IANA timezone name (e.g., 'Asia/Tokyo', 'America/San_Francisco'). Optional: defaults to the server's local timezone, 'UTC', when omitted.",
            "title": "Target Timezone",
            "type": "string"
          }
        },
        "required": [
          "time"
        ],
        "type": "object",
        "title": "convert_timeArguments"
      },
