#!/usr/bin/env node
// A stand-in for pi 1.5.0 for tests/pi-adapter.test.ts: --version, and a turn that prints the JSON event stream records
// the adapter reads (the session header, tool_execution_end, the assistant's message_end), scripted by markers in the
// message, which the adapter passes as the last argument after "--". Every turn appends its argv and a few environment
// facts to STUB_LOG (the API key only as set or unset) and one line to <session-dir>/<session-id>.jsonl, so a resumed
// session shows in the reply.
import fs from 'node:fs';
import path from 'node:path';
import cp from 'node:child_process';
const argv = process.argv.slice(2);
if (argv[0] === '--version') { console.log(process.env.STUB_PI_VERSION || '1.5.0'); process.exit(0); }
const opt = (name) => { const i = argv.indexOf(name); return i >= 0 ? argv[i + 1] : null; };
const dash = argv.indexOf('--');
const message = dash >= 0 ? argv.slice(dash + 1).join(' ') : '';
const env = process.env;
fs.appendFileSync(env.STUB_LOG, JSON.stringify({ argv, key: env.HE_MODEL_API_KEY ? 'set' : 'unset', home: env.HOME, agent_dir: env.PI_CODING_AGENT_DIR, tmpdir: env.TMPDIR,
  offline: env.PI_OFFLINE ?? null, telemetry: env.PI_TELEMETRY ?? null, skip_version: env.PI_SKIP_VERSION_CHECK ?? null, cwd: process.cwd(),
  world: env.HE_WORLD_MCP_URL ? 'set' : 'unset', stdin_tty: process.stdin.isTTY ?? false }) + '\n');
const id = opt('--session-id'), dir = opt('--session-dir');
let n = 1;
if (id && dir) {
  fs.mkdirSync(dir, { recursive: true });
  const file = path.join(dir, id + '.jsonl');
  n = (fs.existsSync(file) ? fs.readFileSync(file, 'utf8').split('\n').filter(Boolean).length : 0) + 1;
  fs.appendFileSync(file, JSON.stringify({ turn: n }) + '\n');
}
const out = (ev) => process.stdout.write(JSON.stringify(ev) + '\n');
const assistant = (extra) => out({ type: 'message_end', message: { role: 'assistant', content: [], api: 'stub', provider: opt('--provider'), model: opt('--model'), thinkingLevel: opt('--thinking'), ...extra } });
const tool = (isError, text) => out({ type: 'tool_execution_end', toolCallId: 'call_1', toolName: 'post_message', result: { content: [{ type: 'text', text }] }, isError });
if (message.includes('[stub:crash]')) { process.stderr.write('pi: crashed\n'); process.exit(1); }
if (message.includes('[stub:no-world]')) { process.stderr.write('world-mcp: HE-ADAPTER-004 could not list the world tools at http://world/mcp: world MCP transport error: fetch failed\n'); process.exit(2); }
out({ type: 'session', version: 3, id, timestamp: '2026-11-08T00:00:00.000Z', cwd: process.cwd() });
out({ type: 'agent_start' });
if (message.includes('[stub:sleep]')) {
  cp.spawn('sleep', ['3017'], { stdio: 'ignore', detached: true }).unref();
  cp.spawnSync('sleep', ['3029']);
  process.exit(0);
}
if (message.includes('[stub:403]')) assistant({ stopReason: 'error', errorMessage: '403 {"type":"error","error":{"type":"permission_error","message":"metering proxy: refused"}}' });
else if (message.includes('[stub:openai-402]')) assistant({ stopReason: 'error', errorMessage: 'OpenAI API error (402): lease spent' });
else if (message.includes('[stub:conn]')) assistant({ stopReason: 'error', errorMessage: 'Connection error.' });
else if (message.includes('[stub:other-error]')) assistant({ stopReason: 'error', errorMessage: 'No API key found for provider anthropic' });
else if (message.includes('[stub:aborted]')) assistant({ stopReason: 'aborted' });
else if (message.includes('[stub:exit1]')) { assistant({ stopReason: 'stop', content: [{ type: 'text', text: 'done' }] }); process.exit(1); }
else {
  if (message.includes('[stub:transport]')) tool(true, 'world MCP transport error: HTTP 502 bad gateway');
  if (message.includes('[stub:tool-error]')) tool(true, '{"error":"not_found","message":"no such channel"}');
  assistant({ stopReason: 'stop', content: [{ type: 'thinking', thinking: 'hm' }, { type: 'text', text: 'stub reply ' + n + ' in ' + id }] });
}
out({ type: 'agent_settled', aborted: false });
