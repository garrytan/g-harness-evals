#!/usr/bin/env bash
# Test stand-in for the openclaw CLI (tests/openai-branch.test.ts). An agent turn
# (`openclaw agent ...`) is recorded and answered without a model: the arguments
# and the provider environment the adapter handed OpenClaw go to
# $HE_LOG_DIR/stub-turns.jsonl, and the reply is a fixed envelope. In the image
# every other command runs the pinned CLI, so the config the adapter writes is
# OpenClaw's own. On a host without the pinned CLI (the process-level golden
# test) --version prints $OPENCLAW_VERSION, `mcp set <name> <json>` is recorded
# to $HE_LOG_DIR/stub-mcp.jsonl and leaves the config alone, and the other mcp
# commands succeed with no output. Every invocation's arguments go to
# $HE_LOG_DIR/stub-calls.jsonl (tests/instruction-route.test.ts compares them).
# The host stand-ins for the plugin commands (route-hook, the gbrain turn
# hook): install, enable and config set succeed; plugins inspect <id> reports
# the plugin with status $HE_STUB_PLUGIN_STATUS (default loaded) and the
# before_prompt_build hook.
set -euo pipefail
python3 -c 'import json, sys; print(json.dumps(sys.argv[1:]))' "$@" >> "$HE_LOG_DIR/stub-calls.jsonl"
if [ "${1:-}" != agent ]; then
  [ -x /opt/harness/bin/openclaw ] && exec /opt/harness/bin/openclaw "$@"
  case "${1:-} ${2:-}" in
    "--version "*) echo "OpenClaw $OPENCLAW_VERSION" ;;
    "mcp set") python3 -c 'import json, sys; print(json.dumps({"name": sys.argv[1], "definition": json.loads(sys.argv[2])}))' "$3" "$4" >> "$HE_LOG_DIR/stub-mcp.jsonl" ;;
    "mcp "*) ;;
    "plugins install"|"plugins enable"|"config set") ;;
    "plugins inspect") printf '{"plugin":{"id":"%s","status":"%s","enabled":true,"source":"stub"},"shape":"hook-only","typedHooks":[{"name":"before_prompt_build"}]}\n' "$3" "${HE_STUB_PLUGIN_STATUS:-loaded}" ;;
    *) echo "openclaw stub: no host stand-in for: $*" >&2; exit 2 ;;
  esac
  exit 0
fi
python3 - "$@" >> "$HE_LOG_DIR/stub-turns.jsonl" <<'PY'
import json, os, re, sys
env = {k: v for k, v in sorted(os.environ.items()) if re.match(r"^(ANTHROPIC_|OPENAI_|OPENCLAW_|HOME$)", k)}
print(json.dumps({"argv": sys.argv[1:], "env": env}))
PY
# internal-task: on a hook route (the adapter's emit flag exists) run the installed he-instruction-route plugin's before_prompt_build as
# OpenClaw would for the turn and record the flag and the sha256 of the prependContext it returned (null for none) to
# $HE_LOG_DIR/stub-emit.jsonl.
plugin="${OPENCLAW_STATE_DIR:-}/he-instruction-route/index.js" flag="${HE_SESSION_STATE_DIR:-/harness-state}/he-route/emit"
if [ -e "$flag" ] && [ -e "$plugin" ]; then
  node --input-type=module -e '
    const [plugin, flag] = process.argv.slice(1);
    const { createHash } = await import("node:crypto");
    const { readFileSync } = await import("node:fs");
    const handlers = {};
    (await import(plugin)).default.register({ on: (name, fn) => { handlers[name] = fn; } });
    const out = await handlers.before_prompt_build({}, {});
    const text = out && out.prependContext;
    console.log(JSON.stringify({ emit: readFileSync(flag, "utf8"), context_sha256: [text ? createHash("sha256").update(text).digest("hex") : null] }));
  ' "$plugin" "$flag" >> "$HE_LOG_DIR/stub-emit.jsonl"
fi
if [ "${2:-}" = exec ]; then
  printf '{"ok":true,"status":"ok","final":"ok","payloads":[{"text":"ok"}]}\n'
else
  printf '{"payloads":[{"text":"ok"}],"meta":{}}\n'
fi
