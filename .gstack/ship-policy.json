{
  "$schema": "https://github.com/garrytan/gstack/docs/ship-policy.md#schema-v1",
  "min_gstack_version": "1.97.0.0",
  "readers": {
    "brief_note": "Sealed custody: never read, list, hash, cat, grep, copy or attach custody objects or the custody key, and never run any git command against the custody remote or the custody branch. Never run commands that print environment variables."
  },
  "ci_record_timeout_s": 900,
  "merge": "direct",
  "changelog_fragments": {
    "dir": "changelog.d"
  },
  "stamp_files": [
    "VERSION",
    "package.json",
    "CHANGELOG.md",
    "README.md",
    "docs/gbrain-arm.md",
    "gbrain/README.md",
    "runner/README.md"
  ],
  "review_exclude_paths": [
    "tasks/multiuser/v0.4/dev/**/*.json",
    "tasks/multiuser/v0.4/rehearsal/**/*.json",
    "tasks/multiuser/v0.4/rehearsal/corpus/**",
    "docs/benchmarks/*/results*/trials/**",
    "docs/benchmarks/*/results*/turns/**",
    "docs/benchmarks/*/results*/**/*.sqlite",
    "docs/benchmarks/*/results*/**/*.ndjson",
    "docs/benchmarks/*/results*/**/*.log",
    "docs/benchmarks/*/results*/**/*.jsonl",
    "docs/benchmarks/*/results*/*.manifest.json",
    "docs/benchmarks/*/results*/**/manifest.json",
    "docs/benchmarks/*/results*/**/summary.json",
    "docs/benchmarks/*/results*/**/summary.regraded.json",
    "docs/benchmarks/2026-11-09-fable-5-2-coding/results*/**/analysis.json",
    "docs/benchmarks/2026-11-12-fable-5-2-coding-cc322/results*/**/analysis.json",
    "docs/benchmarks/*/results*/**/trials/**",
    "docs/benchmarks/*/results*/**/*.manifest.json",
    "docs/benchmarks/2026-11-08-skill-resolver/results*/**/analysis.json",
    "docs/benchmarks/2026-11-08-skill-resolver/results/checks/sett-*.json",
    "docs/benchmarks/2026-11-08-skill-resolver/results/merged/summary.md",
    "docs/benchmarks/2026-11-08-skill-resolver/results/tools/openclaw-phase-b-*.txt",
    "docs/benchmarks/*/probe/trials/**",
    "docs/benchmarks/*/probe/**/*.sqlite",
    "docs/benchmarks/*/probe/**/*.ndjson",
    "docs/benchmarks/*/probe/**/*.jsonl",
    "docs/benchmarks/*/probe/*.manifest.json",
    "docs/benchmarks/*/probe/**/manifest.json",
    "docs/benchmarks/*/main/trials/**",
    "docs/benchmarks/*/main/shards/**",
    "docs/benchmarks/*/main/*.jsonl",
    "docs/benchmarks/*/main/*.ndjson",
    "docs/benchmarks/*/main/**/*.sqlite",
    "docs/benchmarks/*/forced/trials/**",
    "docs/benchmarks/*/forced/shards/**",
    "docs/benchmarks/*/forced/*.jsonl",
    "docs/benchmarks/*/forced/*.ndjson",
    "docs/benchmarks/*/forced/**/*.sqlite",
    "docs/benchmarks/*/headroom/trials/**",
    "docs/benchmarks/*/headroom/shards/**",
    "docs/benchmarks/*/headroom/*.jsonl",
    "docs/benchmarks/*/headroom/*.ndjson",
    "docs/benchmarks/*/headroom/**/*.sqlite",
    "docs/benchmarks/*/calibration/trials/**",
    "docs/benchmarks/*/calibration/shards/**",
    "docs/benchmarks/*/calibration/*.jsonl",
    "docs/benchmarks/*/calibration/*.ndjson",
    "docs/benchmarks/*/calibration/**/*.sqlite",
    "docs/benchmarks/*/pilot/trials/**",
    "docs/benchmarks/*/pilot/shards/**",
    "docs/benchmarks/*/pilot/*.jsonl",
    "docs/benchmarks/*/pilot/*.ndjson",
    "docs/benchmarks/*/pilot/**/*.sqlite",
    "docs/benchmarks/*/corpus/**/*.jsonl",
    "docs/benchmarks/*/layer1/**/*.jsonl",
    "docs/benchmarks/*/layer1/**/*.json",
    "tasks/multiuser/company-v2/dev/**/*.json",
    "tasks/multiuser/personal-v2/dev/**/*.json"
  ]
}
