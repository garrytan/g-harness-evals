      "reason": "community-claims long tasks: the message-key names in generated test cases (gen/build.py), pinned as an exact list, names not credentials"
    },
    {
      "finding": "env.kv",
      "paths": [
        "tasks/community-claims/long/**/spec.json"
      ],
      "pattern": "[a-z0-9_.-]+(?:/[a-z0-9_.-]+)+(?=\")",
      "reason": "community-claims long tasks: path-like token fields in generated checklist specs (gen/build.py), file paths not credentials"
    },
    {
      "finding": "env.kv",
      "paths": [
        "tasks/community-claims/long/**/*.py"
      ],
      "pattern": "(?:cust(?:)omer_id|prom(?:)oter_id|remo(?:)ved_events|remo(?:)ved_schedules|remo(?:)ved_shows|remo(?:)ved_transactions|tota(?:)l_items)(?=')",
      "reason": "community-claims long tasks: the field-name constants in generated Python, pinned as an exact list, names not credentials"
    },
    {
      "finding": "env.kv",
      "paths": [
        "tasks/community-claims/long/**/*.py"
