  "allowlist": [
    {
      "finding": "env.kv",
      "paths": [
        "harnesses/codex/config/config.toml",
        "tests/fixtures/adapter-baselines/*/harnesses/codex/config/config.toml"
      ],
      "pattern": "HE_MODEL_API_KEY\"$",
      "reason": "Codex env_key names the environment variable the adapter reads its proxy bearer from; the line holds a variable name, not a value"
    },
    {
      "finding": "env.kv",
      "paths": [
        "harnesses/pi/pin.json"
      ],
      "pattern": "(?:x-api-key:|Authorization: Bearer) HE_MODEL_API_KEY",
      "reason": "Pi's pin describes the header each model route sends: the api_key field names the header and the environment variable the adapter fills it from (the per-trial dummy token), a variable name, not a value"
    },
    {
      "finding": "env.kv",
      "paths": [
        "tests/fixtures/canary-gstack/plain-render-golden.json"
      ],
      "pattern": "OPENAI_API_KEY",
      "reason": "golden of the plain Codex config the canary renders: env_key names the environment variable Codex reads, a variable name, not a value"
    },
    {
      "finding": "env.kv",
      "paths": [
        "tests/fixtures/adapter-baselines/*/harnesses/openclaw/pin.json"
      ],
      "pattern": "agent:main:dm:<member> \\| agent:main:channel:<id> \\(HE_SESSION_SCOPE=turn: agent:main:turn:<NNNN>\\); :t<thread_ts> appended when TurnRequest\\.thread_ts is set \\(a task turn with thread = \\\\\"new\\\\\" opens a new session in the same conversation\\)\",$",
      "reason": "verbatim copy of main's harnesses/openclaw/pin.json description text"
    },
    {
      "finding": "env.kv",
      "paths": [
        "tests/codex-adapter.test.ts"
      ],
      "pattern": "trialToken\\('[a-z0-9-]+'\\),$",
      "reason": "a source call that generates an ephemeral per-trial proxy bearer at test time (runner/trial/proxy.ts trialToken); the line holds no literal value"
    },
    {
      "finding": "internal.url_private",
      "paths": [
        "scripts/gstack-laneb/vm-run.sh"
      ],
      "pattern": "http://127\\.0\\.0\\.1:8790/laneb/anthropic(?=')",
      "reason": "in-VM loopback address of the Lane B metering proxy (#123); loopback only, no external host, no credential"
    },
    {
      "finding": "pii.email",
      "paths": [
        "tasks/repo/gstack-native-v1/dev/*/verifier/**"
      ],
      "pattern": "(s\\.astanin@gmail\\.com|janne\\.vanhala@gmail\\.com|mail@dbader\\.org)(?![\\w.@-])",
      "reason": "upstream maintainers' published author addresses in vendored MIT-licensed files of the public dev split (#120), kept as upstream wrote them"
    },
    {
      "finding": "env.kv",
      "paths": [
        "docs/benchmarks/*/results/*/laneb/jobs/*/*/result.json",
        "docs/benchmarks/*/results/*/trials/*/*/*/harbor/result.json"
      ],
      "pattern": "s-[0-9a-f]{12}\",?\\s*$",
      "reason": "Lane B proxy session id (s- plus 12 hex) that the bridge writes into each Harbor result.json's laneb block as \"session\": \"s-<12 hex>\"; a correlation id for the metering proxy's session log, not a credential. The pattern starts at the value because gstack-pregate anchors it at the finding's column, so it cannot check the key: any env.kv value of exactly this shape ending its line on these two paths passes"
    },
    {
      "finding": "env.kv",
      "paths": [
        "docs/benchmarks/2026-11-06-qm-s1-edition/*/trials/*/llm-turn*.json"
      ],
      "pattern": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\"",
      "reason": "provider prompt-cache id (prompt_cache_key), not a credential. pregate env.kv patterns see only the value (lib/pregate/allowlist.ts col slice), so this cannot be key-anchored; any credential-named key with a lowercase-UUID value on these paths would also pass pregate. gitleaks S3 at export stays key-anchored and still flags such a key."
    },
    {
      "finding": "env.kv",
      "paths": [
        "tasks/community-claims/long/**/cases.json"
      ],
      "pattern": "(?:appr(?:)oved_email_greeting|appr(?:)oved_email_line1|appr(?:)oved_email_line2|appr(?:)oved_email_signoff|appr(?:)oved_email_subject|canc(?:)el_with_fee|canc(?:)elled_email_greeting|canc(?:)elled_email_line1)(?=\")",
      "reason": "community-claims long tasks: the message-key names in generated test cases (gen/build.py), pinned as an exact list, names not credentials"
    },
    {
      "finding": "env.kv",
      "paths": [
        "tasks/community-claims/long/**/cases.json"
      ],
      "pattern": "(?:canc(?:)elled_email_line2|canc(?:)elled_email_signoff|canc(?:)elled_email_subject|conf(?:)irmed_email_greeting|conf(?:)irmed_email_line1|conf(?:)irmed_email_line2|conf(?:)irmed_email_signoff|conf(?:)irmed_email_subject)(?=\")",
      "reason": "community-claims long tasks: the message-key names in generated test cases (gen/build.py), pinned as an exact list, names not credentials"
    },
    {
      "finding": "env.kv",
      "paths": [
        "tasks/community-claims/long/**/cases.json"
      ],
      "pattern": "(?:due_(?:)tomorrow|expo(?:)rt_amount|expo(?:)rt_date|expo(?:)rt_name|pick(?:)up_sms_message|pick(?:)up_sms_one|pick(?:)up_sms_other|push(?:)_delayed|push(?:)_on_time|rece(?:)ipt_columns|rece(?:)ipt_discount|rece(?:)ipt_heading)(?=\")",
      "reason": "community-claims long tasks: the message-key names in generated test cases (gen/build.py), pinned as an exact list, names not credentials"
    },
    {
