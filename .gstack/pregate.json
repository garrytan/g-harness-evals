      "\\bsk-ant-[a-z]{3,8}[0-9]{2}-[A-Za-z0-9_-]{20,}",
      "\\bsk-proj-[A-Za-z0-9_-]{20,}",
      "\\bsk-svcacct-[A-Za-z0-9_-]{20,}",
      "\\bsk-admin-[A-Za-z0-9_-]{20,}",
      "\\bsk-[A-Za-z0-9]{20}T3BlbkFJ[A-Za-z0-9]{20}\\b",
      "\\bsk-or-v1-[0-9a-f]{64}\\b",
      "\\bxai-[A-Za-z0-9]{50,}",
      "\\bpplx-[A-Za-z0-9]{40,}",
      "AGE-SECRET-KEY-1[QPZRY9X8GF2TVDW0S3JN54KHCE6MUA7L]{58}"
    ],
    "visibility": "public",
    "allow_paths": [
      "tasks/repo/*/heldout/MANIFEST.json",
      "tasks/multiuser/*/heldout/MANIFEST.json"
    ],
    "local_paths": true
  },
