  "runner": "bun test {files}",
  "timeout_s": 2400,
  "run_profiles": {
    "ci/checks": {
      "workflow": "ci.yml",
      "events": [
        "pull_request",
        "push"
      ],
      "jobs": [
        "checks"
      ],
      "artifact": "checks-tree",
      "os": "Linux"
    }
