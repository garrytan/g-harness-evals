      "paths": [
        "tasks/community-claims/long/**/cases.json"
      ],
      "pattern": "(?:requ(?:)est_bad_quantity|requ(?:)est_missing_name|sche(?:)duled_email_greeting|sche(?:)duled_email_line1|sche(?:)duled_email_line2|sche(?:)duled_email_signoff|sche(?:)duled_email_subject|stat(?:)us_active|stat(?:)us_cancelled)(?=\")",
      "reason": "community-claims long tasks: the message-key names in generated test cases (gen/build.py), pinned as an exact list, names not credentials"
    },
